# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会提交到仓库）
# 取值优先级：进程环境变量 > .env > agent/config/agent_config.yaml

# 必填：LLM API Key，默认从变量名 AGENT_API_KEY 读取
AGENT_API_KEY=

# 选填：覆盖配置文件中的端点与模型（留空则使用 agent_config.yaml 中的值）
# AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AGENT_MODEL=qwen-plus
